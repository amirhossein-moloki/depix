services:
  nginx:
    image: nginx:alpine
    container_name: depix-gateway
    volumes:
      - ./infrastructure/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./infrastructure/nginx/conf.d:/etc/nginx/conf.d:ro
    ports:
      - "8080:80"
    depends_on:
      backend:
        condition: service_healthy
      frontend:
        condition: service_started
    networks:
      - depix-network

  postgres:
    image: postgres:16-alpine
    container_name: crmerp-postgres
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-crm_erp_db}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgrespassword}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres}"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - depix-network

  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: crmerp-backend
    environment:
      - ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT:-Development}
      - ConnectionStrings__Database=Host=postgres;Port=5432;Database=${POSTGRES_DB:-crm_erp_db};Username=${POSTGRES_USER:-postgres};Password=${POSTGRES_PASSWORD:-postgrespassword}
      - Jwt__Secret=${Jwt__Secret:-Development_Placeholder_Jwt_Secret_Key_32_Bytes_Long_Minimum!}
      - Jwt__Issuer=${Jwt__Issuer:-CrmErpApi}
      - Jwt__Audience=${Jwt__Audience:-CrmErpClients}
      - Jwt__AccessTokenExpirationMinutes=${Jwt__AccessTokenExpirationMinutes:-60}
      - Jwt__RefreshTokenExpirationDays=${Jwt__RefreshTokenExpirationDays:-7}
      - Cors__AllowedOrigins__0=${Cors__AllowedOrigins__0:-http://localhost:3000}
      - Cors__AllowedOrigins__1=${Cors__AllowedOrigins__1:-http://localhost:8080}
      - OPENAPI_ENABLED=${OPENAPI_ENABLED:-true}
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5000/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
    networks:
      - depix-network

  frontend:
    image: node:20-alpine
    container_name: depix-frontend
    restart: unless-stopped
    working_dir: /app
    volumes:
      - /var/www/dedpix:/app
    command: sh -c "if [ -f package.json ]; then npm start -- -p 3000; else echo 'Frontend source not found' && exit 1; fi"
    networks:
      - depix-network

networks:
  depix-network:
    driver: bridge

volumes:
  postgres_data:

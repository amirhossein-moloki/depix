services:
  nginx:
    image: nginx:alpine
    container_name: depix-gateway
    volumes:
      - ./infrastructure/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./infrastructure/nginx/conf.d:/etc/nginx/conf.d:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    ports:
      - "80:80"
      - "443:443"
    depends_on:
      backend:
        condition: service_healthy
      frontend:
    image: depix-frontend:latest
    container_name: depix-frontend
    restart: unless-stopped
    networks:
      - depix-network

networks:
  depix-network:
    driver: bridge

volumes:
  postgres_data:

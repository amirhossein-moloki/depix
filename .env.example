# ==========================================
# Depix Platform - Environment Configuration Template
# ==========================================

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Database=Host=postgres;Port=5432;Database=crm_erp_db;Username=postgres;Password=postgrespassword

# JWT Authentication
Jwt__Secret=SuperSecretJwtSigningKeyWithSufficientLength32PlusChars!
Jwt__Issuer=DepixPlatform
Jwt__Audience=DepixClients

# Unified OpenAPI & Swagger
OPENAPI_ENABLED=true
OPENAPI_BASE_URL=http://localhost:8080

# Medusa ↔ Payload Integration Layer Services
MEDUSA_INTERNAL_URL=http://medusa:9000
MEDUSA_INTERNAL_API_KEY=your_medusa_internal_api_key_placeholder

PAYLOAD_INTERNAL_URL=http://payload:3000
PAYLOAD_INTERNAL_API_KEY=your_payload_internal_api_key_placeholder

INTEGRATION_INTERNAL_URL=http://integration:3001
INTEGRATION_INTERNAL_API_KEY=your_integration_internal_api_key_placeholder

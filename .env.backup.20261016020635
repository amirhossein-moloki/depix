# ===================================================================
# Depix Platform - Local Development Environment Configuration Template
# ===================================================================
# Copy this file to .env for local development overrides if necessary.
# ===================================================================

# Nginx Reverse Proxy & Gateway Settings
PUBLIC_DOMAIN=depix.ir
BACKEND_HOST=backend
BACKEND_PORT=5000
FRONTEND_HOST=frontend
FRONTEND_PORT=3000
SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/depix.ir/fullchain.pem
SSL_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/depix.ir/privkey.pem
ACME_CHALLENGE_PATH=/var/www/html

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Database=Host=postgres;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>

# Database Credentials (used by Docker Compose)
POSTGRES_DB=crm_erp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_GENERATED_PASSWORD
INTEGRATION_INTERNAL_API_KEY=YOUR_GENERATED_API_KEY
# JWT Authentication
Jwt__Secret=<DEVELOPMENT_JWT_SECRET_32_BYTES_MINIMUM>
Jwt__Issuer=CrmErpApi
Jwt__Audience=CrmErpClients
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# CORS Allowed Origins
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:8080

# Storage
FileStorage__BasePath=/app/uploads

# Unified OpenAPI & Swagger
OPENAPI_ENABLED=false
OPENAPI_BASE_URL=http://localhost:8080

# Service-to-Service Integration Endpoints and Keys
MEDUSA_INTERNAL_URL=http://medusa:9000
MEDUSA_INTERNAL_API_KEY=<MEDUSA_INTERNAL_API_KEY>

PAYLOAD_INTERNAL_URL=http://payload:3000
PAYLOAD_INTERNAL_API_KEY=<PAYLOAD_INTERNAL_API_KEY>

INTEGRATION_INTERNAL_URL=http://integration:3001
INTEGRATION_INTERNAL_API_KEY=<INTEGRATION_INTERNAL_API_KEY>

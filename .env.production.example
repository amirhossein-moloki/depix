# ===================================================================
# Depix CRM/ERP Platform - Production Environment Configuration Template
# ===================================================================
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT
# COPY THIS FILE TO .env AND FILL IN REAL PRODUCTION VALUES BEFORE DEPLOYMENT
# ===================================================================

# Nginx Reverse Proxy & Production Host Configuration
PUBLIC_DOMAIN=yourdomain.com
BACKEND_HOST=backend
BACKEND_PORT=5000
FRONTEND_HOST=frontend
FRONTEND_PORT=3000
SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
ACME_CHALLENGE_PATH=/var/www/html

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration (PostgreSQL)
POSTGRES_DB=<PRODUCTION_DATABASE_NAME>
POSTGRES_USER=<PRODUCTION_DATABASE_USER>
POSTGRES_PASSWORD=<PRODUCTION_DATABASE_PASSWORD_SECRET>

# JWT Authentication
# JWT_SECRET MUST BE AT LEAST 32 CHARACTERS (256 BITS) AND RANDOMLY GENERATED
JWT_SECRET=<PRODUCTION_RANDOM_JWT_SECRET_KEY_32_CHARS_MINIMUM>
JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=https://app.yourdomain.com
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGIN=https://app.yourdomain.com

# File Storage Root Directory
STORAGE_ROOT_PATH=/app/uploads

# OpenAPI / Swagger Documentation Control
OPENAPI_ENABLED=false

# Service-to-Service Integration Key
INTEGRATION_INTERNAL_API_KEY=<PRODUCTION_INTERNAL_SERVICE_API_KEY_SECRET>

# Microservice / Integration Layer Internal Service Endpoints (Docker Internal DNS)
MEDUSA_INTERNAL_URL=http://medusa:9000
PAYLOAD_INTERNAL_URL=http://payload:3000
INTEGRATION_INTERNAL_URL=http://integration:3001
